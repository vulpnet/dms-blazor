@implements IDisposable
@using DmsBlazor.Client.Auth
@inject AuthState Auth
@inject NavigationManager Nav

@if (initialized)
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (IsPublicRoute(routeData) || Auth.IsAuthenticated)
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
            else
            {
                // Chưa đăng nhập mà vào trang cần xác thực — điều hướng ngay, không render
                // nội dung trang (tránh lộ dữ liệu trong 1 khoảnh khắc trước khi redirect).
            }
        </Found>
    </Router>
}

@code {
    // Gọi AuthState.InitializeAsync() (đọc localStorage qua JS interop) ở đây thay
    // vì trong Program.cs trước host.RunAsync() — JS interop chưa sẵn sàng tại thời
    // điểm đó trong WASM, gọi sớm quá gây lỗi ngầm ngay lúc app vừa load. Không render
    // Router cho tới khi biết chắc trạng thái đăng nhập, tránh nhấp nháy sai route.
    private bool initialized;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await Auth.InitializeAsync();
        initialized = true;
        RedirectIfNeeded();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        RedirectIfNeeded();

    private static bool IsPublicRoute(Microsoft.AspNetCore.Components.RouteData routeData) =>
        routeData.PageType == typeof(Pages.DangNhap) || routeData.PageType == typeof(Pages.NotFound);

    private void RedirectIfNeeded()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var isLoginPage = relativePath.TrimEnd('/').Equals("dang-nhap", StringComparison.OrdinalIgnoreCase);

        if (!Auth.IsAuthenticated && !isLoginPage)
            Nav.NavigateTo("/dang-nhap");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
