@implements IDisposable
@inject NavigationManager Nav

<div class="sidebar @(collapseNavMenu ? "" : "open")">
    <div class="brand-row">
        <div class="brand-mark">DL</div>
        <a class="navbar-brand" href="">DMS &amp; Logistics</a>
    </div>

    <button class="navbar-toggler" title="Mở menu" @onclick="ToggleNavMenu">☰</button>

    <nav class="nav-scrollable">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span> Tổng quan sản phẩm
            </NavLink>
        </div>

        @foreach (var group in Groups)
        {
            var isOpen = openGroups.Contains(group.Label);
            <div class="nav-group">
                <button class="nav-group-head @(isOpen ? "open" : "")" @onclick="() => ToggleGroup(group.Label)">
                    <span class="chev">▶</span> @group.Label
                </button>
                <div class="nav-group-items @(isOpen ? "open" : "")">
                    @foreach (var item in group.Items)
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@item.Href">
                                <span class="nav-icon">@item.Icon</span> @item.Label
                            </NavLink>
                        </div>
                    }
                </div>
            </div>
        }
    </nav>
</div>

@code {
    private record NavItem(string Href, string Icon, string Label);
    private record NavGroup(string Label, NavItem[] Items);

    private static readonly NavGroup[] Groups =
    [
        new("Báo cáo", [
            new("dashboard", "📊", "Báo cáo quản trị"),
        ]),
        new("Bán hàng", [
            new("lich-tuyen-hom-nay", "🗓️", "Lịch tuyến hôm nay"),
            new("dat-hang", "🛒", "Đặt hàng"),
            new("don-hang", "📋", "Đơn hàng"),
            new("cong-no", "💰", "Công nợ"),
            new("tuyen-ban-hang", "🧭", "Tuyến bán hàng"),
        ]),
        new("Vận chuyển", [
            new("van-chuyen", "🚚", "Chuyến giao hàng"),
            new("tai-xe", "🧑‍✈️", "Tài xế"),
            new("ton-kho", "📦", "Tồn kho"),
        ]),
        new("Danh mục", [
            new("san-pham", "🏷️", "Sản phẩm"),
            new("khach-hang", "🧑‍🤝‍🧑", "Khách hàng"),
            new("nha-phan-phoi", "🏢", "Nhà phân phối"),
            new("nhan-vien-ban-hang", "🧑‍💼", "Nhân viên bán hàng"),
        ]),
    ];

    private bool collapseNavMenu = true;
    // Nhóm chứa trang đang xem tự mở khi tải trang; các nhóm khác mặc định thu gọn
    // (không nhớ giữa các lần vào trang — chỉ tính theo route hiện tại mỗi lần load).
    private readonly HashSet<string> openGroups = [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        OpenGroupOfCurrentPage();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        OpenGroupOfCurrentPage();
        StateHasChanged();
    }

    private void OpenGroupOfCurrentPage()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var group = Groups.FirstOrDefault(g => g.Items.Any(i => relativePath.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase)));
        if (group is not null) openGroups.Add(group.Label);
    }

    private void ToggleGroup(string label)
    {
        if (!openGroups.Add(label)) openGroups.Remove(label);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
