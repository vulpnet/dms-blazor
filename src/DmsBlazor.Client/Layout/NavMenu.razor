@implements IDisposable
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Auth
@inject NavigationManager Nav
@inject AuthState Auth

<div class="sidebar @(collapseNavMenu ? "" : "open")">
    <div class="brand-row">
        <div class="brand-mark">DL</div>
        <a class="navbar-brand" href="">DMS &amp; Logistics</a>
    </div>

    <button class="navbar-toggler" title="Mở menu" @onclick="ToggleNavMenu">☰</button>

    <nav class="nav-scrollable">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span> Tổng quan sản phẩm
            </NavLink>
        </div>

        @foreach (var group in VisibleGroups)
        {
            var isOpen = openGroups.Contains(group.Label);
            <div class="nav-group">
                <button class="nav-group-head @(isOpen ? "open" : "")" @onclick="() => ToggleGroup(group.Label)">
                    <span class="chev">▶</span> @group.Label
                </button>
                <div class="nav-group-items @(isOpen ? "open" : "")">
                    @foreach (var item in group.Items)
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@item.Href">
                                <span class="nav-icon">@item.Icon</span> @item.Label
                            </NavLink>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Auth.Role == UserRole.Admin)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="tai-khoan">
                    <span class="nav-icon">🔑</span> Quản lý tài khoản
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="nhat-ky-hoat-dong">
                    <span class="nav-icon">📜</span> Nhật ký hoạt động
                </NavLink>
            </div>
        }
    </nav>

    @if (Auth.IsAuthenticated)
    {
        <div class="user-row">
            <a class="user-info" href="doi-mat-khau" title="Đổi mật khẩu">
                <div class="user-name">@Auth.DisplayName</div>
                <div class="user-role">@RoleLabel(Auth.Role)</div>
            </a>
            <button class="btn-logout" title="Đăng xuất" @onclick="Logout">⏻</button>
        </div>
    }
</div>

@code {
    private record NavItem(string Href, string Icon, string Label, UserRole[]? Roles = null);
    private record NavGroup(string Label, NavItem[] Items, UserRole[]? Roles = null);

    private static readonly NavGroup[] Groups =
    [
        new("Báo cáo", [
            new("dashboard", "📊", "Báo cáo quản trị"),
        ]),
        new("Bán hàng", [
            new("lich-tuyen-hom-nay", "🗓️", "Lịch tuyến hôm nay", [UserRole.Admin, UserRole.SalesRep]),
            new("dat-hang", "🛒", "Đặt hàng", [UserRole.Admin, UserRole.SalesRep]),
            new("don-hang", "📋", "Đơn hàng", [UserRole.Admin, UserRole.SalesRep]),
            new("cong-no", "💰", "Công nợ", [UserRole.Admin, UserRole.Accountant]),
            new("tuyen-ban-hang", "🧭", "Tuyến bán hàng", [UserRole.Admin, UserRole.SalesRep]),
        ], [UserRole.Admin, UserRole.SalesRep, UserRole.Accountant]),
        new("Vận chuyển", [
            new("van-chuyen", "🚚", "Chuyến giao hàng", [UserRole.Admin, UserRole.Driver]),
            new("tai-xe", "🧑‍✈️", "Tài xế", [UserRole.Admin, UserRole.Driver]),
            new("ton-kho", "📦", "Tồn kho", [UserRole.Admin, UserRole.Warehouse]),
        ], [UserRole.Admin, UserRole.Driver, UserRole.Warehouse]),
        new("Danh mục", [
            new("san-pham", "🏷️", "Sản phẩm"),
            new("khach-hang", "🧑‍🤝‍🧑", "Khách hàng"),
            new("nha-phan-phoi", "🏢", "Nhà phân phối"),
            new("nhan-vien-ban-hang", "🧑‍💼", "Nhân viên bán hàng"),
        ], [UserRole.Admin]),
    ];

    // Admin thấy hết mọi trang, không bị lọc theo Roles của bất kỳ nhóm/mục nào.
    // Auth.Role có thể null trong khoảnh khắc App.razor chưa kịp redirect về trang
    // đăng nhập — không dùng Auth.Role!.Value ở đây để tránh ném exception lúc đó.
    private bool IsVisible(UserRole[]? allowedRoles) =>
        Auth.Role == UserRole.Admin || allowedRoles is null || (Auth.Role is { } role && allowedRoles.Contains(role));

    private IEnumerable<NavGroup> VisibleGroups =>
        Groups
            .Where(g => IsVisible(g.Roles))
            .Select(g => g with { Items = g.Items.Where(i => IsVisible(i.Roles)).ToArray() })
            .Where(g => g.Items.Length > 0);

    private bool collapseNavMenu = true;
    // Nhóm chứa trang đang xem tự mở khi tải trang; các nhóm khác mặc định thu gọn
    // (không nhớ giữa các lần vào trang — chỉ tính theo route hiện tại mỗi lần load).
    private readonly HashSet<string> openGroups = [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        OpenGroupOfCurrentPage();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        OpenGroupOfCurrentPage();
        StateHasChanged();
    }

    private void OpenGroupOfCurrentPage()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var group = Groups.FirstOrDefault(g => g.Items.Any(i => relativePath.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase)));
        if (group is not null) openGroups.Add(group.Label);
    }

    private void ToggleGroup(string label)
    {
        if (!openGroups.Add(label)) openGroups.Remove(label);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/dang-nhap", forceLoad: true);
    }

    private static string RoleLabel(UserRole? role) => role switch
    {
        UserRole.Admin => "Quản lý",
        UserRole.SalesRep => "Nhân viên bán hàng",
        UserRole.Driver => "Tài xế",
        UserRole.Warehouse => "Thủ kho",
        UserRole.Accountant => "Kế toán công nợ",
        _ => ""
    };

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
