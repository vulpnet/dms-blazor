@page "/van-chuyen"
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@inject DmsApiClient Api

<PageTitle>Vận chuyển — DMS</PageTitle>

<div class="page-header page-header-row">
    <div>
        <h1>Chuyến giao hàng</h1>
        <p>Gom đơn hàng cùng tuyến vào 1 chuyến, gán tài xế và theo dõi tiến độ giao.</p>
    </div>
    <button class="btn-primary" @onclick="OpenCreateForm">+ Tạo chuyến mới</button>
</div>

@if (trips is null)
{
    <div class="skeleton-row">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    @if (showCreateForm)
    {
        <div class="card create-form">
            <h3>Tạo chuyến giao mới</h3>

            @if (drivers is null || pendingOrders is null || warehouses is null)
            {
                <p class="muted">Đang tải dữ liệu...</p>
            }
            else if (drivers.Count == 0)
            {
                <p class="muted">Chưa có tài xế nào — <a href="/tai-xe">thêm tài xế</a> trước khi tạo chuyến.</p>
            }
            else if (pendingOrders.Count == 0)
            {
                <p class="muted">Không có đơn hàng nào đang chờ giao.</p>
            }
            else
            {
                <div class="field-row">
                    <div class="field">
                        <label for="driver-select">Tài xế phụ trách</label>
                        <select id="driver-select" @bind="selectedDriverId">
                            @foreach (var d in drivers)
                            {
                                <option value="@d.Id">@d.Name — @d.VehiclePlate</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="warehouse-select">Kho xuất hàng</label>
                        <select id="warehouse-select" @bind="selectedWarehouseId">
                            @foreach (var w in warehouses)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <label class="field-label">Chọn đơn hàng đưa vào chuyến</label>
                <table class="data-table">
                    <thead>
                        <tr><th></th><th>Mã đơn</th><th>Kênh</th><th>Nhà phân phối</th><th class="text-right">Tổng tiền</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in pendingOrders)
                        {
                            <tr>
                                <td><input type="checkbox" checked="@selectedOrderIds.Contains(o.Id)" @onchange="e => ToggleOrder(o.Id, e.Value is true)" /></td>
                                <td><code>@o.OrderCode</code></td>
                                <td>@(o.Channel == SalesChannel.Npp ? "NPP" : "Bán lẻ")</td>
                                <td>@(o.DistributorName ?? "—")</td>
                                <td class="text-right">@o.Total.ToString("N0")k</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (createError is not null)
                {
                    <div class="alert-error">@createError</div>
                }

                <div class="modal-actions">
                    <button class="btn-outline" @onclick="() => showCreateForm = false">Huỷ bỏ</button>
                    <button class="btn-primary" disabled="@(selectedOrderIds.Count == 0 || creating)" @onclick="SubmitCreateTrip">
                        @(creating ? "Đang tạo..." : "Tạo chuyến giao")
                    </button>
                </div>
            }
        </div>
    }

    @if (trips.Count == 0)
    {
        <p class="muted">Chưa có chuyến giao nào.</p>
    }
    else
    {
        <div class="filter-bar">
            <input class="filter-search" @bind="searchText" @bind:event="oninput" placeholder="Tìm theo mã chuyến, tài xế..." />
            <select class="filter-select" @bind="statusFilter">
                <option value="">Tất cả trạng thái</option>
                <option value="@nameof(TripStatus.Planning)">Đang gom đơn</option>
                <option value="@nameof(TripStatus.OnTheWay)">Đang giao</option>
                <option value="@nameof(TripStatus.Completed)">Hoàn tất</option>
            </select>
        </div>

        @if (FilteredTrips.Count == 0)
        {
            <p class="muted">Không có chuyến giao nào khớp bộ lọc.</p>
        }
        else
        {
        <div class="card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Mã chuyến</th>
                        <th>Tài xế</th>
                        <th>Xe</th>
                        <th class="text-right">Số đơn</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in FilteredTrips)
                    {
                        <tr>
                            <td><code>@t.TripCode</code></td>
                            <td>@t.DriverName</td>
                            <td>@t.VehiclePlate</td>
                            <td class="text-right">@t.Orders.Count</td>
                            <td><span class="channel-badge @TripBadgeClass(t.Status)">@TripStatusLabel(t.Status)</span></td>
                            <td class="row-actions"><a href="/van-chuyen/@t.TripCode" class="btn-link">Xem chi tiết</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    }
}

<style>
    .page-header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .btn-primary {
        background: var(--brand); color: #fff; border: none; border-radius: 8px;
        padding: 0.6rem 1.2rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;
    }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-outline {
        border: 1px solid var(--line-strong); color: var(--ink); background: var(--surface);
        padding: 0.55rem 1rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer;
    }
    .text-right { text-align: right; }
    .row-actions { text-align: right; white-space: nowrap; }
    .btn-link { color: var(--brand); font-weight: 600; font-size: 0.83rem; text-decoration: none; }
    .btn-link:hover { text-decoration: underline; }
    .muted { color: var(--muted); font-size: 0.85rem; }

    .channel-badge { font-size: 0.75rem; font-weight: 650; padding: 0.2rem 0.55rem; border-radius: 999px; }
    .channel-badge.planning { background: #eef1f5; color: #475569; }
    .channel-badge.ontheway { background: var(--brand-soft); color: var(--brand); }
    .channel-badge.completed { background: var(--success-soft); color: var(--success); }

    .filter-bar { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .filter-search { flex: 1; min-width: 220px; padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; }
    .filter-select { padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; }

    .create-form { margin-bottom: 1.5rem; }
    .create-form h3 { margin-bottom: 1rem; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 700px; }
    @@media (max-width: 700px) {
        .field-row { grid-template-columns: 1fr; }
    }
    .field { margin-bottom: 1rem; max-width: 340px; }
    .field label, .field-label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 0.4rem; }
    .field select { width: 100%; padding: 0.55rem 0.7rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.25rem; }
</style>

@code {
    private List<DeliveryTrip>? trips;
    private List<Driver>? drivers;
    private List<Order>? pendingOrders;
    private List<Warehouse>? warehouses;
    private bool showCreateForm;
    private int selectedDriverId;
    private int selectedWarehouseId;
    private HashSet<int> selectedOrderIds = [];
    private bool creating;
    private string? createError;
    private string searchText = "";
    private string statusFilter = "";

    private List<DeliveryTrip> FilteredTrips => (trips ?? [])
        .Where(t => string.IsNullOrWhiteSpace(searchText)
            || t.TripCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || t.DriverName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(t => string.IsNullOrEmpty(statusFilter) || t.Status.ToString() == statusFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        trips = await Api.GetTripsAsync() ?? [];
    }

    private async Task OpenCreateForm()
    {
        createError = null;
        selectedOrderIds.Clear();
        showCreateForm = true;
        drivers = await Api.GetDriversAsync();
        pendingOrders = await Api.GetPendingOrdersAsync();
        warehouses = await Api.GetWarehousesAsync();
        selectedDriverId = drivers?.FirstOrDefault()?.Id ?? 0;
        selectedWarehouseId = warehouses?.FirstOrDefault(w => w.Type == WarehouseType.Central)?.Id ?? warehouses?.FirstOrDefault()?.Id ?? 0;
    }

    private void ToggleOrder(int orderId, bool isChecked)
    {
        if (isChecked) selectedOrderIds.Add(orderId);
        else selectedOrderIds.Remove(orderId);
    }

    private async Task SubmitCreateTrip()
    {
        createError = null;
        creating = true;
        var (success, error) = await Api.CreateTripAsync(new CreateTripRequest
        {
            DriverId = selectedDriverId,
            SourceWarehouseId = selectedWarehouseId,
            OrderIds = selectedOrderIds.ToList()
        });
        creating = false;

        if (!success)
        {
            createError = error ?? "Không thể tạo chuyến giao.";
            return;
        }

        showCreateForm = false;
        trips = await Api.GetTripsAsync() ?? [];
    }

    private static string TripStatusLabel(TripStatus s) => s switch
    {
        TripStatus.Planning => "Đang gom đơn",
        TripStatus.OnTheWay => "Đang giao",
        TripStatus.Completed => "Hoàn tất",
        _ => s.ToString()
    };

    private static string TripBadgeClass(TripStatus s) => s switch
    {
        TripStatus.Planning => "planning",
        TripStatus.OnTheWay => "ontheway",
        TripStatus.Completed => "completed",
        _ => ""
    };
}
