@page "/van-chuyen"
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@inject DmsApiClient Api

<PageTitle>Vận chuyển — DMS</PageTitle>

<div class="page-header">
    <h1>Theo dõi vận chuyển</h1>
    <p>Trạng thái, vị trí trên tuyến đường và cảnh báo trễ hẹn theo thời gian thực.</p>
</div>

@if (shipments is null)
{
    <div class="skeleton-row">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    <div class="kpi-row">
        <Kpi Label="Tổng đơn đang theo dõi" Value="@shipments.Count.ToString()" />
        <Kpi Label="Đơn trễ hẹn" Value="@shipments.Count(s => s.Status == ShipmentStatus.Delayed).ToString()" Tone="danger" />
        <Kpi Label="Đã giao thành công" Value="@shipments.Count(s => s.Status == ShipmentStatus.Delivered).ToString()" Tone="ok" />
    </div>

    <div class="filters" role="tablist">
        <button role="tab" aria-selected="@(statusFilter is null)" class="@(statusFilter is null ? "chip active" : "chip")" @onclick="() => SetStatusFilter(null)">Tất cả</button>
        @foreach (var st in Enum.GetValues<ShipmentStatus>())
        {
            <button role="tab" aria-selected="@(statusFilter == st)" class="@(statusFilter == st ? "chip active" : "chip")" @onclick="() => SetStatusFilter(st)">@StatusLabel(st)</button>
        }
    </div>

    <div class="shipment-layout">
        <div class="shipment-list">
            @foreach (var s in filtered)
            {
                <button class="@(selected?.Id == s.Id ? "ship-item selected" : "ship-item")" @onclick="() => selected = s">
                    <div class="ship-row">
                        <b>@s.Code</b>
                        <span class="ship-badge @StatusBadgeClass(s.Status)">@StatusLabel(s.Status)</span>
                    </div>
                    <div>@s.Distributor</div>
                    <div class="muted">@s.Region · @EtaLabel(s.EtaHours)</div>
                </button>
            }
        </div>

        <div class="shipment-detail">
            @if (selected is not null)
            {
                <div class="detail-header">
                    <div>
                        <h3>@selected.Code</h3>
                        <div class="muted">@selected.Distributor</div>
                    </div>
                    <span class="ship-badge @StatusBadgeClass(selected.Status)">@StatusLabel(selected.Status)</span>
                </div>

                <div class="detail-meta">
                    <div><span class="muted">Tài xế</span><div>@selected.Driver</div></div>
                    <div><span class="muted">Phương tiện</span><div>@selected.Vehicle</div></div>
                    <div><span class="muted">Quãng đường</span><div>@selected.DistanceKm km</div></div>
                </div>

                <div class="route">
                    <div class="route-labels"><span>🏭 Kho tổng</span><span>📍 Điểm giao</span></div>
                    <div class="route-track">
                        <div class="route-fill" style="width:@selected.ProgressPercent%; background:@(selected.Status == ShipmentStatus.Delayed ? "#dc2626" : selected.ProgressPercent >= 100 ? "#16a34a" : "#2563eb")"></div>
                    </div>
                </div>

                <h4>Lộ trình chi tiết</h4>
                <ol class="timeline">
                    @foreach (var step in selected.Timeline)
                    {
                        <li class="@(step.Delayed ? "delayed" : step.Done ? "done" : "")">
                            <span class="dot">@(step.Delayed ? "!" : step.Done ? "✓" : "")</span>
                            <div>
                                <div class="step-label">@step.Label</div>
                                <div class="muted">@step.Time</div>
                            </div>
                        </li>
                    }
                </ol>
            }
        </div>
    </div>
}

<style>
    .filters { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .chip {
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        font-size: 0.83rem;
        font-weight: 500;
    }
    .chip:hover { border-color: var(--brand); color: var(--brand); }
    .chip.active { background: var(--brand); border-color: var(--brand); color: #fff; }

    .shipment-layout { display: grid; grid-template-columns: 1fr 1.4fr; gap: 1.25rem; }
    @@media (max-width: 860px) {
        .shipment-layout { grid-template-columns: 1fr; }
    }
    .shipment-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .ship-item {
        text-align: left;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.85rem;
        background: var(--surface);
        cursor: pointer;
        box-shadow: var(--shadow-sm);
    }
    .ship-item:hover { border-color: var(--line-strong); }
    .ship-item.selected { border-color: var(--brand); background: var(--brand-soft); box-shadow: none; }
    .ship-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem; }

    .ship-badge { font-size: 0.72rem; padding: 0.22rem 0.6rem; border-radius: 999px; font-weight: 650; }
    .ship-badge.picked { background: #eef1f5; color: #475569; }
    .ship-badge.transit { background: var(--brand-soft); color: var(--brand); }
    .ship-badge.delivery { background: var(--warning-soft); color: var(--warning); }
    .ship-badge.delivered { background: var(--success-soft); color: var(--success); }
    .ship-badge.delayed { background: var(--danger-soft); color: var(--danger); }

    .shipment-detail {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.35rem;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
    }
    .detail-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 1.1rem; }
    .detail-header h3 { font-size: 1.05rem; margin-bottom: 0.2rem; }
    .detail-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1.4rem; font-size: 0.87rem; }
    .detail-meta > div > div:last-child { font-weight: 600; margin-top: 0.15rem; }

    .route-labels { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--muted); }
    .route-track { position: relative; height: 8px; background: var(--canvas); border-radius: 999px; margin: 0.45rem 0 1.4rem; overflow: hidden; }
    .route-fill { position: absolute; inset: 0 auto 0 0; border-radius: 999px; transition: width 0.3s; }

    .shipment-detail h4 { font-size: 0.88rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 0.85rem; }
    .timeline { list-style: none; padding: 0; margin: 0; }
    .timeline li { display: flex; gap: 0.65rem; margin-bottom: 1rem; }
    .timeline .dot {
        width: 24px; height: 24px;
        border-radius: 999px;
        background: var(--canvas);
        color: var(--muted);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 700; flex-shrink: 0;
    }
    .timeline li.done .dot { background: var(--success-soft); color: var(--success); }
    .timeline li.delayed .dot { background: var(--danger-soft); color: var(--danger); }
    .step-label { font-size: 0.9rem; font-weight: 600; color: var(--ink); }
    .muted { color: var(--muted); font-size: 0.82rem; }
</style>

@code {
    private List<Shipment>? shipments;
    private List<Shipment> filtered = [];
    private ShipmentStatus? statusFilter;
    private Shipment? selected;

    protected override async Task OnInitializedAsync()
    {
        shipments = await Api.GetShipmentsAsync();
        filtered = shipments ?? [];
        selected = filtered.FirstOrDefault();
    }

    private void SetStatusFilter(ShipmentStatus? status)
    {
        statusFilter = status;
        filtered = status is null ? shipments ?? [] : (shipments ?? []).Where(s => s.Status == status).ToList();
        selected = filtered.FirstOrDefault();
    }

    private static string StatusLabel(ShipmentStatus s) => s switch
    {
        ShipmentStatus.PickedUp => "Đã lấy hàng",
        ShipmentStatus.InTransit => "Đang vận chuyển",
        ShipmentStatus.OutForDelivery => "Đang giao hàng",
        ShipmentStatus.Delivered => "Đã giao",
        ShipmentStatus.Delayed => "Trễ hẹn",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(ShipmentStatus s) => s switch
    {
        ShipmentStatus.PickedUp => "picked",
        ShipmentStatus.InTransit => "transit",
        ShipmentStatus.OutForDelivery => "delivery",
        ShipmentStatus.Delivered => "delivered",
        ShipmentStatus.Delayed => "delayed",
        _ => ""
    };

    private static string EtaLabel(double hours) =>
        hours < 0 ? $"Trễ {Math.Abs(hours):0.0} giờ" : hours == 0 ? "Đã hoàn tất" : $"Còn {hours:0.0} giờ";
}
