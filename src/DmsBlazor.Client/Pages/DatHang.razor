@page "/dat-hang"
@using System.Web
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@inject DmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Đặt hàng — DMS</PageTitle>

<div class="page-header">
    <h1>Đặt hàng</h1>
    <p>Chọn từng sản phẩm và số lượng, thêm vào giỏ hàng — hệ thống tự tính chiết khấu và tặng kèm.</p>
</div>

@if (products is null || distributors is null || customers is null)
{
    <div class="skeleton-row">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    <div class="tabs" role="tablist">
        <button role="tab" aria-selected="@(channel == SalesChannel.Npp)" class="@(channel == SalesChannel.Npp ? "tab active" : "tab")" @onclick="() => SetChannel(SalesChannel.Npp)">Kênh NPP (nhân viên bán hàng)</button>
        <button role="tab" aria-selected="@(channel == SalesChannel.Retail)" class="@(channel == SalesChannel.Retail ? "tab active" : "tab")" @onclick="() => SetChannel(SalesChannel.Retail)">Kênh bán lẻ (khách tự đặt)</button>
    </div>

    <div class="order-layout">
        <div class="order-products">
            @if (channel == SalesChannel.Npp)
            {
                @if (distributors.Count == 0)
                {
                    <p class="muted">Chưa có nhà phân phối nào đang hợp tác — <a href="/nha-phan-phoi">thêm nhà phân phối</a> trước khi đặt đơn kênh này.</p>
                }
                else
                {
                    <div class="field">
                        <label for="distributor-select">Tạo đơn cho nhà phân phối</label>
                        <select id="distributor-select" @bind="selectedDistributorId">
                            @foreach (var d in distributors)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                }
            }
            else
            {
                @if (customers.Count == 0)
                {
                    <p class="muted">Chưa có khách hàng nào đang hoạt động — <a href="/khach-hang">thêm khách hàng</a> trước khi đặt đơn kênh này.</p>
                }
                else
                {
                    <div class="field">
                        <label for="customer-select">Đặt hàng cho khách hàng</label>
                        <select id="customer-select" @bind="selectedCustomerId">
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                }
            }

            <div class="card picker-card">
                <h3>Chọn sản phẩm</h3>
                <div class="picker-row">
                    <div class="field field-grow">
                        <label for="product-select">Sản phẩm</label>
                        <select id="product-select" @bind="selectedProductId">
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Emoji @p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="qty-input">Số lượng</label>
                        <input id="qty-input" type="number" min="1" @bind="quantityToAdd" />
                    </div>
                    <button class="btn-primary" @onclick="AddToCart">+ Thêm vào giỏ</button>
                </div>
                @if (selectedProductPrice is not null)
                {
                    <p class="picker-hint">
                        Đơn giá: <b>@selectedProductPrice.Value.ToString("N0")k</b> / @selectedProductUnitLabel
                    </p>
                }
            </div>

            <div class="promo-note">
                Khuyến mãi tự động: tổng đơn từ 50 đơn vị giảm 5%, từ 100 giảm 10%. Mua từ 2 sản phẩm, mỗi loại từ 20 trở lên — tặng kèm mỗi loại 1 đơn vị.
            </div>
        </div>

        <div class="order-cart">
            @if (priced is not null)
            {
                <h3>Giỏ hàng</h3>
                @if (priced.Lines.Count == 0)
                {
                    <p class="muted">Chưa chọn sản phẩm nào. Chọn sản phẩm bên trái và bấm "Thêm vào giỏ".</p>
                }
                else
                {
                    @foreach (var line in priced.Lines)
                    {
                        <div class="cart-line">
                            <div>
                                <div>@line.Product.Emoji @line.Product.Name</div>
                                <div class="muted">
                                    @line.Qty × @line.UnitPrice.ToString("N0")k
                                    @if (line.FreeUnits > 0)
                                    {
                                        <span class="free-tag">+ tặng @line.FreeUnits</span>
                                    }
                                </div>
                            </div>
                            <div class="cart-line-actions">
                                <span>@line.LineTotal.ToString("N0")k</span>
                                <button class="btn-remove" title="Xoá khỏi giỏ" aria-label="Xoá @line.Product.Name khỏi giỏ" @onclick="() => RemoveFromCart(line.Product.Id)">✕</button>
                            </div>
                        </div>
                    }
                }

                <div class="cart-summary">
                    <div class="row"><span>Tổng số lượng</span><span>@priced.TotalQty</span></div>
                    <div class="row"><span>Tạm tính</span><span>@priced.Subtotal.ToString("N0")k</span></div>
                    @if (priced.DiscountPercent > 0)
                    {
                        <div class="row discount"><span>Chiết khấu @priced.DiscountPercent%</span><span>-@priced.DiscountAmount.ToString("N0")k</span></div>
                    }
                    <div class="row total"><span>Thành tiền</span><span>@priced.Total.ToString("N0")k</span></div>
                </div>

                @if (confirmError is not null)
                {
                    <div class="alert-error">@confirmError</div>
                }

                <button class="btn-primary full" disabled="@(priced.Lines.Count == 0 || confirming)" @onclick="ConfirmOrder">
                    @(confirming ? "Đang xử lý..." : "Xác nhận đơn hàng")
                </button>
            }
        </div>
    </div>
}

<style>
    .field { margin-bottom: 1.1rem; }
    .field label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 0.4rem;
    }
    .field select, .field input {
        width: 100%;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        font-size: 0.88rem;
        background: var(--surface);
        color: var(--ink);
    }
    #distributor-select { max-width: 340px; }
    .order-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
    @@media (max-width: 860px) {
        .order-layout { grid-template-columns: 1fr; }
    }

    .picker-card { margin-bottom: 1rem; }
    .picker-row { display: flex; align-items: flex-end; gap: 0.75rem; flex-wrap: wrap; }
    .picker-row .field { margin-bottom: 0; }
    .field-grow { flex: 1; min-width: 220px; }
    #qty-input { width: 90px; text-align: center; font-variant-numeric: tabular-nums; }
    .picker-hint { margin: 0.85rem 0 0; font-size: 0.83rem; color: var(--muted); }

    .promo-note {
        margin-top: 1.25rem;
        background: var(--brand-soft);
        border: 1px solid #c7d7ff;
        color: #1d3a8f;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        font-size: 0.82rem;
        line-height: 1.5;
    }
    .order-cart {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.35rem;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        align-self: start;
        position: sticky;
        top: 72px;
    }
    .order-cart h3 { font-size: 1rem; margin-bottom: 1rem; }
    .cart-line { display: flex; justify-content: space-between; font-size: 0.87rem; margin-bottom: 0.7rem; gap: 0.5rem; }
    .cart-line-actions { display: flex; align-items: center; gap: 0.5rem; }
    .btn-remove {
        border: none; background: transparent; color: var(--muted); cursor: pointer;
        font-size: 0.8rem; padding: 0.1rem 0.3rem; line-height: 1;
    }
    .btn-remove:hover { color: var(--danger); }
    .free-tag {
        color: var(--success);
        font-weight: 650;
        margin-left: 0.35rem;
        background: var(--success-soft);
        padding: 0.05rem 0.4rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }
    .cart-summary { border-top: 1px solid var(--line); padding-top: 0.85rem; margin-top: 0.6rem; font-size: 0.87rem; }
    .cart-summary .row { display: flex; justify-content: space-between; margin-bottom: 0.4rem; }
    .cart-summary .discount { color: var(--success); font-weight: 600; }
    .cart-summary .total {
        font-weight: 700;
        font-size: 1.05rem;
        border-top: 1px solid var(--line);
        padding-top: 0.6rem;
        margin-top: 0.2rem;
        color: var(--ink);
    }
    .btn-primary {
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        padding: 0.65rem 1.2rem;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .btn-primary:hover:not(:disabled) { background: var(--brand-hover); }
    .btn-primary.full { width: 100%; margin-top: 1.1rem; padding: 0.8rem; }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .muted { color: var(--muted); font-size: 0.83rem; }
</style>

@code {
    private List<Product>? products;
    private List<Distributor>? distributors;
    private List<Customer>? customers;
    private SalesChannel channel = SalesChannel.Npp;
    private int selectedDistributorId;
    private int selectedCustomerId;
    private int selectedProductId;
    private int quantityToAdd = 1;
    private readonly Dictionary<int, int> cart = [];
    private PricedOrder? priced;
    private bool confirming;
    private string? confirmError;

    private Product? SelectedProduct => products?.FirstOrDefault(p => p.Id == selectedProductId);
    private decimal? selectedProductPrice =>
        SelectedProduct is { } p ? (channel == SalesChannel.Npp ? p.PricePerCase : p.PricePerUnit) : null;
    private string selectedProductUnitLabel =>
        SelectedProduct is { } p
            ? (channel == SalesChannel.Npp ? $"thùng ({p.CaseSize} {p.Unit})" : p.Unit)
            : "";

    protected override async Task OnInitializedAsync()
    {
        products = await Api.GetProductsAsync();
        distributors = await Api.GetDistributorsAsync();
        customers = await Api.GetCustomersAsync();
        selectedProductId = products?.FirstOrDefault()?.Id ?? 0;

        // Hỗ trợ điều hướng sẵn kênh + khách/NPP từ trang Lịch tuyến hôm nay
        // (?channel=Retail&customerId=5) — bấm 1 điểm dừng là vào thẳng đơn đúng khách.
        var uri = new Uri(Nav.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        if (Enum.TryParse<SalesChannel>(query["channel"], out var preselectedChannel))
            channel = preselectedChannel;

        selectedDistributorId = int.TryParse(query["distributorId"], out var distId) && distributors?.Any(d => d.Id == distId) == true
            ? distId
            : distributors?.FirstOrDefault()?.Id ?? 0;
        selectedCustomerId = int.TryParse(query["customerId"], out var custId) && customers?.Any(c => c.Id == custId) == true
            ? custId
            : customers?.FirstOrDefault()?.Id ?? 0;

        await RefreshPrice();
    }

    private void SetChannel(SalesChannel c)
    {
        channel = c;
        cart.Clear();
        confirmError = null;
        _ = RefreshPrice();
    }

    private async Task AddToCart()
    {
        if (selectedProductId == 0 || quantityToAdd <= 0) return;

        cart[selectedProductId] = cart.GetValueOrDefault(selectedProductId, 0) + quantityToAdd;
        quantityToAdd = 1;
        await RefreshPrice();
    }

    private async Task RemoveFromCart(int productId)
    {
        cart.Remove(productId);
        await RefreshPrice();
    }

    private async Task RefreshPrice()
    {
        var request = BuildRequest();
        priced = await Api.PriceOrderAsync(request);
    }

    private async Task ConfirmOrder()
    {
        confirming = true;
        confirmError = null;
        var request = BuildRequest();
        var (order, error) = await Api.ConfirmOrderAsync(request);
        confirming = false;

        if (order is null)
        {
            confirmError = error ?? "Đặt hàng không thành công.";
            return;
        }

        Nav.NavigateTo($"/don-hang/{order.OrderCode}");
    }

    private CreateOrderRequest BuildRequest() => new()
    {
        Channel = channel,
        DistributorId = channel == SalesChannel.Npp ? selectedDistributorId : null,
        CustomerId = channel == SalesChannel.Retail ? selectedCustomerId : null,
        Lines = cart.Where(kv => kv.Value > 0).Select(kv => new OrderLineInput { ProductId = kv.Key, Qty = kv.Value }).ToList()
    };
}
