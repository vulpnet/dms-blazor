@page "/dat-hang"
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@inject DmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Đặt hàng — DMS</PageTitle>

<div class="page-header">
    <h1>Đặt hàng</h1>
    <p>Tạo đơn theo kênh sỉ (nhà phân phối) hoặc bán lẻ, hệ thống tự tính chiết khấu và tặng kèm.</p>
</div>

@if (products is null || distributors is null)
{
    <div class="skeleton-row">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    <div class="tabs" role="tablist">
        <button role="tab" aria-selected="@(channel == SalesChannel.Npp)" class="@(channel == SalesChannel.Npp ? "tab active" : "tab")" @onclick="() => SetChannel(SalesChannel.Npp)">Kênh NPP (nhân viên bán hàng)</button>
        <button role="tab" aria-selected="@(channel == SalesChannel.Retail)" class="@(channel == SalesChannel.Retail ? "tab active" : "tab")" @onclick="() => SetChannel(SalesChannel.Retail)">Kênh bán lẻ (khách tự đặt)</button>
    </div>

    <div class="order-layout">
        <div class="order-products">
            @if (channel == SalesChannel.Npp)
            {
                <div class="field">
                    <label for="distributor-select">Tạo đơn cho nhà phân phối</label>
                    <select id="distributor-select" @bind="selectedDistributorId">
                        @foreach (var d in distributors)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="product-grid">
                @foreach (var p in products)
                {
                    var qty = cart.GetValueOrDefault(p.Id, 0);
                    var price = channel == SalesChannel.Npp ? p.PricePerCase : p.PricePerUnit;
                    var unitLabel = channel == SalesChannel.Npp ? $"thùng ({p.CaseSize} {p.Unit})" : p.Unit;
                    <div class="product-card">
                        <div class="product-emoji">@p.Emoji</div>
                        <div class="product-name">@p.Name</div>
                        <div class="product-price">@price.ToString("N0")k / @unitLabel</div>
                        <div class="qty-control">
                            <button aria-label="Giảm số lượng @p.Name" @onclick="() => ChangeQty(p.Id, qty - 1)">−</button>
                            <input type="number" min="0" aria-label="Số lượng @p.Name" value="@qty" @onchange="e => ChangeQty(p.Id, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)" />
                            <button aria-label="Tăng số lượng @p.Name" @onclick="() => ChangeQty(p.Id, qty + 1)">+</button>
                        </div>
                    </div>
                }
            </div>

            <div class="promo-note">
                Khuyến mãi tự động: tổng đơn từ 50 đơn vị giảm 5%, từ 100 giảm 10%. Mua từ 2 sản phẩm, mỗi loại từ 20 trở lên — tặng kèm mỗi loại 1 đơn vị.
            </div>
        </div>

        <div class="order-cart">
            @if (priced is not null)
            {
                <h3>Giỏ hàng</h3>
                @if (priced.Lines.Count == 0)
                {
                    <p class="muted">Chưa chọn sản phẩm nào.</p>
                }
                else
                {
                    @foreach (var line in priced.Lines)
                    {
                        <div class="cart-line">
                            <div>
                                <div>@line.Product.Emoji @line.Product.Name</div>
                                <div class="muted">
                                    @line.Qty × @line.UnitPrice.ToString("N0")k
                                    @if (line.FreeUnits > 0)
                                    {
                                        <span class="free-tag">+ tặng @line.FreeUnits</span>
                                    }
                                </div>
                            </div>
                            <div>@line.LineTotal.ToString("N0")k</div>
                        </div>
                    }
                }

                <div class="cart-summary">
                    <div class="row"><span>Tổng số lượng</span><span>@priced.TotalQty</span></div>
                    <div class="row"><span>Tạm tính</span><span>@priced.Subtotal.ToString("N0")k</span></div>
                    @if (priced.DiscountPercent > 0)
                    {
                        <div class="row discount"><span>Chiết khấu @priced.DiscountPercent%</span><span>-@priced.DiscountAmount.ToString("N0")k</span></div>
                    }
                    <div class="row total"><span>Thành tiền</span><span>@priced.Total.ToString("N0")k</span></div>
                </div>

                @if (confirmError is not null)
                {
                    <div class="alert-error">@confirmError</div>
                }

                <button class="btn-primary full" disabled="@(priced.Lines.Count == 0 || confirming)" @onclick="ConfirmOrder">
                    @(confirming ? "Đang xử lý..." : "Xác nhận đơn hàng")
                </button>
            }
        </div>
    </div>
}

<style>
    .field { margin-bottom: 1.1rem; }
    .field label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 0.4rem;
    }
    .field select {
        width: 100%;
        max-width: 340px;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line-strong);
        border-radius: 8px;
        font-size: 0.88rem;
        background: var(--surface);
        color: var(--ink);
    }
    .order-layout { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; }
    @@media (max-width: 860px) {
        .order-layout { grid-template-columns: 1fr; }
    }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .product-card {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1rem;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
    }
    .product-emoji { font-size: 1.5rem; }
    .product-name { font-weight: 600; margin-top: 0.4rem; font-size: 0.92rem; }
    .product-price { color: var(--brand); font-size: 0.84rem; font-weight: 650; margin: 0.35rem 0 0.6rem; }
    .qty-control { display: flex; align-items: center; gap: 0.4rem; }
    .qty-control button {
        width: 30px; height: 30px;
        border: 1px solid var(--line-strong);
        background: var(--surface);
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        color: var(--ink);
    }
    .qty-control button:hover { border-color: var(--brand); color: var(--brand); }
    .qty-control input {
        width: 56px;
        text-align: center;
        border: 1px solid var(--line-strong);
        border-radius: 6px;
        padding: 0.3rem;
        font-size: 0.88rem;
        font-variant-numeric: tabular-nums;
    }
    .promo-note {
        margin-top: 1.25rem;
        background: var(--brand-soft);
        border: 1px solid #c7d7ff;
        color: #1d3a8f;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        font-size: 0.82rem;
        line-height: 1.5;
    }
    .order-cart {
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.35rem;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        align-self: start;
        position: sticky;
        top: 72px;
    }
    .order-cart h3 { font-size: 1rem; margin-bottom: 1rem; }
    .cart-line { display: flex; justify-content: space-between; font-size: 0.87rem; margin-bottom: 0.7rem; gap: 0.5rem; }
    .free-tag {
        color: var(--success);
        font-weight: 650;
        margin-left: 0.35rem;
        background: var(--success-soft);
        padding: 0.05rem 0.4rem;
        border-radius: 4px;
        font-size: 0.75rem;
    }
    .cart-summary { border-top: 1px solid var(--line); padding-top: 0.85rem; margin-top: 0.6rem; font-size: 0.87rem; }
    .cart-summary .row { display: flex; justify-content: space-between; margin-bottom: 0.4rem; }
    .cart-summary .discount { color: var(--success); font-weight: 600; }
    .cart-summary .total {
        font-weight: 700;
        font-size: 1.05rem;
        border-top: 1px solid var(--line);
        padding-top: 0.6rem;
        margin-top: 0.2rem;
        color: var(--ink);
    }
    .btn-primary {
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        padding: 0.65rem 1.2rem;
        font-size: 0.9rem;
    }
    .btn-primary:hover:not(:disabled) { background: var(--brand-hover); }
    .btn-primary.full { width: 100%; margin-top: 1.1rem; padding: 0.8rem; }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .muted { color: var(--muted); font-size: 0.83rem; }
</style>

@code {
    private List<Product>? products;
    private List<Distributor>? distributors;
    private SalesChannel channel = SalesChannel.Npp;
    private int selectedDistributorId;
    private readonly Dictionary<int, int> cart = [];
    private PricedOrder? priced;
    private bool confirming;
    private string? confirmError;

    protected override async Task OnInitializedAsync()
    {
        products = await Api.GetProductsAsync();
        distributors = await Api.GetDistributorsAsync();
        selectedDistributorId = distributors?.FirstOrDefault()?.Id ?? 0;
        foreach (var p in products ?? [])
            cart[p.Id] = 0;
        await RefreshPrice();
    }

    private void SetChannel(SalesChannel c)
    {
        channel = c;
        foreach (var key in cart.Keys.ToList())
            cart[key] = 0;
        confirmError = null;
        _ = RefreshPrice();
    }

    private async Task ChangeQty(int productId, int qty)
    {
        cart[productId] = Math.Max(0, qty);
        await RefreshPrice();
    }

    private async Task RefreshPrice()
    {
        var request = BuildRequest();
        priced = await Api.PriceOrderAsync(request);
    }

    private async Task ConfirmOrder()
    {
        confirming = true;
        confirmError = null;
        var request = BuildRequest();
        var (order, error) = await Api.ConfirmOrderAsync(request);
        confirming = false;

        if (order is null)
        {
            confirmError = error ?? "Đặt hàng không thành công.";
            return;
        }

        Nav.NavigateTo($"/don-hang/{order.OrderCode}");
    }

    private CreateOrderRequest BuildRequest() => new()
    {
        Channel = channel,
        DistributorId = channel == SalesChannel.Npp ? selectedDistributorId : null,
        Lines = cart.Where(kv => kv.Value > 0).Select(kv => new OrderLineInput { ProductId = kv.Key, Qty = kv.Value }).ToList()
    };
}
