@page "/lich-tuyen-hom-nay"
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@inject DmsApiClient Api
@inject NavigationManager Nav

<PageTitle>Lịch tuyến hôm nay — DMS</PageTitle>

<div class="page-header">
    <h1>Lịch tuyến hôm nay</h1>
    <p>Danh sách điểm bán cần ghé thăm hôm nay theo tuyến đã gán — bấm vào 1 điểm để đặt hàng ngay.</p>
</div>

@if (reps is null)
{
    <div class="skeleton-row"><div class="skeleton-card"></div></div>
}
else if (reps.Count == 0)
{
    <p class="muted">Chưa có nhân viên bán hàng nào — <a href="/nhan-vien-ban-hang">thêm nhân viên</a> trước.</p>
}
else
{
    <div class="field">
        <label for="rep-select">Bạn là</label>
        <select id="rep-select" @bind="selectedRepId" @bind:after="LoadToday">
            @foreach (var r in reps)
            {
                <option value="@r.Id">@r.Name</option>
            }
        </select>
    </div>

    @if (stops is null)
    {
        <div class="skeleton-row"><div class="skeleton-card"></div></div>
    }
    else if (stops.Count == 0)
    {
        <p class="muted">Hôm nay không có điểm dừng nào trong lịch tuyến của bạn.</p>
    }
    else
    {
        <div class="filter-bar">
            <input class="filter-search" @bind="searchText" @bind:event="oninput" placeholder="Tìm theo tên điểm bán, mã tuyến..." />
            <select class="filter-select" @bind="statusFilter">
                <option value="">Tất cả trạng thái</option>
                <option value="@nameof(VisitStatus.NotVisited)">Chưa ghé</option>
                <option value="@nameof(VisitStatus.VisitedNoOrder)">Đã ghé, không đặt</option>
                <option value="@nameof(VisitStatus.Ordered)">Đã đặt đơn</option>
            </select>
        </div>

        @if (FilteredStops.Count == 0)
        {
            <p class="muted">Không có điểm dừng nào khớp bộ lọc.</p>
        }
        else
        {
        <div class="card">
            <table class="data-table">
                <thead>
                    <tr><th></th><th>Điểm bán</th><th>Tuyến</th><th>Loại</th><th>Trạng thái</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var (stop, index) in FilteredStops.Select((s, i) => (s, i)))
                    {
                        <tr class="clickable-row @(stop.Status != VisitStatus.NotVisited ? "row-done" : "")" @onclick="() => ToggleRouteDetail(stop.RouteCode)">
                            <td>@(index + 1)</td>
                            <td>@stop.StopName</td>
                            <td><code>@stop.RouteCode</code></td>
                            <td>@(stop.StopType == StopType.Customer ? "Khách hàng" : "Nhà phân phối")</td>
                            <td>
                                <span class="channel-badge @StatusBadgeClass(stop.Status)">@StatusLabel(stop.Status)</span>
                                @if (stop.Status == VisitStatus.VisitedNoOrder && !string.IsNullOrEmpty(stop.VisitNote))
                                {
                                    <div class="muted">Lý do: @stop.VisitNote</div>
                                }
                            </td>
                            <td class="row-actions" @onclick:stopPropagation="true">
                                @if (stop.Status == VisitStatus.NotVisited)
                                {
                                    <button class="btn-outline" @onclick="() => OpenMarkForm(stop)">Đánh dấu đã ghé</button>
                                }
                                <a href="@BuildOrderLink(stop)" class="btn-link">Đặt hàng →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    }
}

@if (detailRouteCode is not null)
{
    <div class="modal-backdrop" @onclick="() => detailRouteCode = null">
        <div class="modal-panel modal-panel-lg" @onclick:stopPropagation="true">
            <h3>Chi tiết tuyến <code>@detailRouteCode</code></h3>

            <h4>✅ Đã đặt đơn (@DetailOrderedStops.Count())</h4>
            @if (!DetailOrderedStops.Any())
            {
                <p class="muted">Chưa có điểm nào đặt đơn hôm nay.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var stop in DetailOrderedStops)
                    {
                        <li>
                            <span>@stop.StopName</span>
                            <span class="detail-type">@(stop.StopType == StopType.Customer ? "Khách hàng" : "Nhà phân phối")</span>
                        </li>
                    }
                </ul>
            }

            <h4>⏳ Chưa đặt đơn (@DetailPendingStops.Count())</h4>
            @if (!DetailPendingStops.Any())
            {
                <p class="muted">Tất cả điểm trong tuyến đã đặt đơn hôm nay.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var stop in DetailPendingStops)
                    {
                        <li>
                            <span>@stop.StopName</span>
                            <span class="detail-type">@(stop.StopType == StopType.Customer ? "Khách hàng" : "Nhà phân phối") · @StatusLabel(stop.Status)</span>
                        </li>
                    }
                </ul>
            }

            <div class="modal-actions">
                <button class="btn-outline" @onclick="() => detailRouteCode = null">Đóng</button>
            </div>
        </div>
    </div>
}

@if (markingStop is not null)
{
    <div class="modal-backdrop" @onclick="() => markingStop = null">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h3>Đánh dấu đã ghé — @markingStop.StopName</h3>
            <p class="muted">Dùng khi đã ghé thăm nhưng khách chưa đặt hàng (vd hết hàng tồn, khách đóng cửa...).</p>
            <div class="field">
                <label for="visit-note">Ghi chú (tuỳ chọn)</label>
                <input id="visit-note" @bind="visitNote" placeholder="vd: Khách hẹn ghé lại tuần sau" />
            </div>
            <div class="modal-actions">
                <button class="btn-outline" @onclick="() => markingStop = null">Huỷ</button>
                <button class="btn-primary" disabled="@marking" @onclick="SubmitMarkVisited">
                    @(marking ? "Đang lưu..." : "Xác nhận đã ghé")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .field { max-width: 320px; margin-bottom: 1.5rem; }
    .field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 0.4rem; }
    .field select, .field input {
        width: 100%; padding: 0.55rem 0.7rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; box-sizing: border-box;
    }
    .muted { color: var(--muted); font-size: 0.78rem; margin-top: 0.2rem; }
    .row-actions { text-align: right; white-space: nowrap; display: flex; gap: 0.5rem; justify-content: flex-end; }
    .btn-link { color: var(--brand); font-weight: 600; font-size: 0.83rem; text-decoration: none; }
    .btn-link:hover { text-decoration: underline; }
    .btn-outline {
        border: 1px solid var(--line-strong); color: var(--ink); background: var(--surface);
        padding: 0.4rem 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.8rem; cursor: pointer;
    }
    .btn-primary {
        background: var(--brand); color: #fff; border: none; border-radius: 8px;
        padding: 0.6rem 1.2rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;
    }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .row-done { opacity: 0.75; }
    .channel-badge { font-size: 0.75rem; font-weight: 650; padding: 0.2rem 0.55rem; border-radius: 999px; }
    .channel-badge.not-visited { background: #eef1f5; color: #475569; }
    .channel-badge.visited-no-order { background: var(--warning-soft); color: var(--warning); }
    .channel-badge.ordered { background: var(--success-soft); color: var(--success); }

    .clickable-row { cursor: pointer; }
    .clickable-row:hover { background: var(--canvas, #f4f6f9); }

    .filter-bar { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .filter-search { flex: 1; min-width: 220px; padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; }
    .filter-select { padding: 0.55rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 8px; font-size: 0.88rem; }

    .modal-backdrop {
        position: fixed; inset: 0; background: rgba(15,23,42,0.45);
        display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 50;
    }
    .modal-panel {
        background: var(--surface); border-radius: var(--radius); padding: 1.5rem;
        width: 100%; max-width: 420px; box-shadow: var(--shadow-md);
    }
    .modal-panel-lg { max-width: 480px; max-height: 85vh; overflow-y: auto; }
    .modal-panel h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
    .modal-panel h4 { font-size: 0.85rem; font-weight: 650; margin: 1.1rem 0 0.5rem; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.6rem; margin-top: 1.25rem; }
    .detail-list { list-style: none; margin: 0; padding: 0; }
    .detail-list li {
        display: flex; justify-content: space-between; gap: 0.75rem;
        padding: 0.5rem 0; border-bottom: 1px solid var(--line); font-size: 0.85rem;
    }
    .detail-list li:last-child { border-bottom: none; }
    .detail-type { color: var(--muted); font-size: 0.78rem; white-space: nowrap; }
</style>

@code {
    private List<SalesRep>? reps;
    private List<TodayStop>? stops;
    private int selectedRepId;

    private TodayStop? markingStop;
    private string visitNote = "";
    private bool marking;

    private string? detailRouteCode;
    private string searchText = "";
    private string statusFilter = "";

    private List<TodayStop> FilteredStops => (stops ?? [])
        .Where(s => string.IsNullOrWhiteSpace(searchText)
            || s.StopName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || s.RouteCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || s.RouteName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(s => string.IsNullOrEmpty(statusFilter) || s.Status.ToString() == statusFilter)
        .ToList();

    private IEnumerable<TodayStop> DetailOrderedStops => (stops ?? [])
        .Where(s => s.RouteCode == detailRouteCode && s.Status == VisitStatus.Ordered)
        .OrderBy(s => s.SortOrder);

    private IEnumerable<TodayStop> DetailPendingStops => (stops ?? [])
        .Where(s => s.RouteCode == detailRouteCode && s.Status != VisitStatus.Ordered)
        .OrderBy(s => s.SortOrder);

    protected override async Task OnInitializedAsync()
    {
        reps = await Api.GetSalesRepsAsync();
        selectedRepId = reps?.FirstOrDefault()?.Id ?? 0;
        if (selectedRepId != 0) await LoadToday();
    }

    private async Task LoadToday()
    {
        stops = null;
        if (selectedRepId == 0) return;
        stops = await Api.GetTodayStopsAsync(selectedRepId);
    }

    private void ToggleRouteDetail(string routeCode) => detailRouteCode = routeCode;

    private void OpenMarkForm(TodayStop stop)
    {
        markingStop = stop;
        visitNote = "";
    }

    private async Task SubmitMarkVisited()
    {
        if (markingStop is null) return;
        marking = true;
        await Api.MarkVisitedAsync(markingStop.RouteStopId, new MarkVisitedRequest { Note = visitNote });
        marking = false;
        markingStop = null;
        await LoadToday();
    }

    private static string BuildOrderLink(TodayStop stop)
    {
        var channel = stop.StopType == StopType.Customer ? "Retail" : "Npp";
        var idParam = stop.StopType == StopType.Customer ? "customerId" : "distributorId";
        return $"/dat-hang?channel={channel}&{idParam}={stop.TargetId}";
    }

    private static string StatusLabel(VisitStatus s) => s switch
    {
        VisitStatus.NotVisited => "Chưa ghé",
        VisitStatus.VisitedNoOrder => "Đã ghé, không đặt",
        VisitStatus.Ordered => "Đã đặt đơn",
        _ => s.ToString()
    };

    private static string StatusBadgeClass(VisitStatus s) => s switch
    {
        VisitStatus.NotVisited => "not-visited",
        VisitStatus.VisitedNoOrder => "visited-no-order",
        VisitStatus.Ordered => "ordered",
        _ => ""
    };
}
