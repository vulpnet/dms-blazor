@page "/dang-nhap"
@layout Layout.EmptyLayout
@using DmsBlazor.Shared.Models
@using DmsBlazor.Client.Services
@using DmsBlazor.Client.Auth
@inject DmsApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Đăng nhập — DMS</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="brand-mark">DL</div>
        <h1>DMS &amp; Logistics</h1>
        <p class="muted">Đăng nhập để tiếp tục.</p>

        <EditForm Model="model" OnValidSubmit="Submit">
            <div class="field">
                <label for="username">Tên đăng nhập</label>
                <input id="username" @bind="model.Username" autofocus />
            </div>
            <div class="field">
                <label for="password">Mật khẩu</label>
                <input id="password" type="password" @bind="model.Password" />
            </div>

            @if (error is not null)
            {
                <div class="alert-error">@error</div>
            }

            <button class="btn-primary full" type="submit" disabled="@loading">
                @(loading ? "Đang đăng nhập..." : "Đăng nhập")
            </button>
        </EditForm>
    </div>
</div>

<style>
    .login-wrap {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: var(--canvas, #f4f6f9); padding: 1rem;
    }
    .login-card {
        background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow-md);
        padding: 2.25rem 2rem; width: 100%; max-width: 360px; text-align: center;
    }
    .brand-mark {
        width: 48px; height: 48px; border-radius: 12px; background: var(--brand); color: #fff;
        display: flex; align-items: center; justify-content: center; font-weight: 700;
        margin: 0 auto 1rem; font-size: 1.1rem;
    }
    .login-card h1 { font-size: 1.2rem; margin-bottom: 0.25rem; }
    .muted { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    .field { text-align: left; margin-bottom: 1rem; }
    .field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 0.4rem; }
    .field input {
        width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--line-strong);
        border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;
    }
    .btn-primary.full {
        width: 100%; background: var(--brand); color: #fff; border: none; border-radius: 8px;
        padding: 0.7rem; font-weight: 600; cursor: pointer; font-size: 0.9rem; margin-top: 0.5rem;
    }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .alert-error {
        background: var(--danger-soft, #fde8e8); color: var(--danger, #c0392b);
        padding: 0.6rem 0.8rem; border-radius: 8px; font-size: 0.83rem; margin-bottom: 1rem;
    }
</style>

@code {
    private readonly LoginRequest model = new();
    private string? error;
    private bool loading;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated) Nav.NavigateTo("/", replace: true);
    }

    private async Task Submit()
    {
        error = null;
        loading = true;
        var (result, err) = await Api.LoginAsync(model);
        loading = false;

        if (result is null)
        {
            error = string.IsNullOrWhiteSpace(err) ? "Sai tên đăng nhập hoặc mật khẩu." : err;
            return;
        }

        await Auth.SignInAsync(result);
        Nav.NavigateTo("/", replace: true);
    }
}
